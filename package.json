{
  "name": "opencode-graphify-refresh",
  "version": "0.1.0",
  "description": "OpenCode plugin — prunes broken graphify nodes and merges your OKF bundle after every graphify update.",
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "agent",
    "graphify",
    "okf",
    "knowledge-graph",
    "code-graph"
  ],
  "homepage": "https://github.com/theOnlyBoy/opencode-graphify-refresh",
  "bugs": {
    "url": "https://github.com/theOnlyBoy/opencode-graphify-refresh/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Nik S. <nikoladious@proton.me>",
    "url": "https://github.com/theOnlyBoy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theOnlyBoy/opencode-graphify-refresh.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "node test/graphify-refresh.test.mjs",
    "lint": "npx oxlint --type-aware --type-check",
    "lint:fix": "npx oxlint --type-aware --type-check --fix",
    "format:style": "npx oxfmt ./src",
    "prepublishOnly": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.18"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22"
  }
}
